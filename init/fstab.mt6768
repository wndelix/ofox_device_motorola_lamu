# Android fstab file.
#<src>                            <mnt_point>            <type>  <mnt_flags and options> <fs_mgr_flags>
system                            /system                ext4    ro                      wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext                        /system_ext            ext4    ro                      wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_dlkm                       /system_dlkm           erofs   ro                      wait,slotselect,avb,logical,first_stage_mount,display="System DLKM"
product                           /product               ext4    ro                      wait,slotselect,avb,logical,first_stage_mount
vendor                            /vendor                erofs   ro                      wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm                       /vendor_dlkm           erofs   ro                      wait,slotselect,avb,logical,first_stage_mount
odm                               /odm                   erofs   ro                      wait,slotselect,avb,logical,first_stage_mount
odm_dlkm                          /odm_dlkm              erofs   ro                      wait,slotselect,avb,logical,first_stage_mount

/dev/block/by-name/super          /super                 emmc    defaults                backup,flashimg,display="Super"

/dev/block/by-name/vbmeta         /vbmeta                emmc    defaults                slotselect,backup,flashimg,display="VBMeta"
/dev/block/by-name/vbmeta_system  /vbmeta_system         emmc    defaults                first_stage_mount,nofail,slotselect,avb=vbmeta,backup,flashimg,display="VBMeta System"
/dev/block/by-name/vbmeta_vendor  /vbmeta_vendor         emmc    defaults                first_stage_mount,nofail,slotselect,backup,flashimg,display="VBMeta Vendor"

/dev/block/by-name/boot           /boot                  emmc    defaults                first_stage_mount,nofail,slotselect,backup,flashimg,display="Boot"
/dev/block/by-name/dtbo           /dtbo                  emmc    defaults                slotselect,backup,flashimg,display="DTBO"
/dev/block/by-name/init_boot      /init_boot             emmc    defaults                slotselect,backup,flashimg,display="Init Boot"
/dev/block/by-name/vendor_boot    /vendor_boot           emmc    defaults                slotselect,backup,flashimg,display="Vendor Boot"

/dev/block/by-name/metadata       /metadata              f2fs    noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata       /data                  f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity

/dev/block/by-name/frp            /persistent            emmc    defaults                defaults
/dev/block/by-name/misc           /misc                  emmc    defaults                defaults
# 'formattable' is TWRP's 'wipeingui' (both share one case in partition.cpp), which would
# put IMEI, radio calibration and DRM keys in the Wipe menu. 'canbewiped' instead keeps them
# out of that menu while still allowing Restore_Tar's internal wipe to succeed.
/dev/block/by-name/nvcfg          /mnt/vendor/nvcfg      ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="NVCFG"
/dev/block/by-name/nvdata         /mnt/vendor/nvdata     ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="NVData"
/dev/block/by-name/persist        /mnt/vendor/persist    ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="Persist"
/dev/block/by-name/protect1       /mnt/vendor/protect_f  ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="Protect F"
/dev/block/by-name/protect2       /mnt/vendor/protect_s  ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="Protect S"
/dev/block/by-name/blackbox       /mnt/blackbox          ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="Blackbox"
/dev/block/by-name/elabel         /mnt/elabel            ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,backup,canbewiped,display="eLabel"

/dev/block/by-name/gz             /gz                    emmc    defaults                defaults,slotselect
/dev/block/by-name/lk             /lk                    emmc    defaults                defaults,slotselect
/dev/block/by-name/logo           /logo                  emmc    defaults                defaults,slotselect
/dev/block/by-name/modem          /modem                 emmc    defaults                defaults,slotselect
/dev/block/by-name/scp            /scp                   emmc    defaults                defaults,slotselect
/dev/block/by-name/spmfw          /spmfw                 emmc    defaults                defaults,slotselect
/dev/block/by-name/sspm           /sspm                  emmc    defaults                defaults,slotselect
/dev/block/by-name/tee            /tee                   emmc    defaults                defaults,slotselect

/dev/block/by-name/boot_para      /boot_para             emmc    defaults                defaults
/dev/block/by-name/efuse          /efuse                 emmc    defaults                defaults
/dev/block/by-name/expdb          /expdb                 emmc    defaults                defaults
/dev/block/by-name/flashinfo      /flashinfo             emmc    defaults                defaults
/dev/block/by-name/mrdump         /mrdump                emmc    defaults                defaults
/dev/block/by-name/nvram          /nvram                 emmc    defaults                defaults
/dev/block/by-name/otp            /otp                   emmc    defaults                defaults
/dev/block/by-name/para           /para                  emmc    defaults                defaults
/dev/block/by-name/proinfo        /proinfo               emmc    defaults                defaults
/dev/block/by-name/seccfg         /seccfg                emmc    defaults                defaults

# The voldmanaged form lands as /auto0 with a generic "Storage" label in recovery.
# mmcblk1 is the SD slot on 11240000.mmc; altdevice covers cards with no partition table.
/dev/block/mmcblk1p1              /external_sd           auto    defaults                storage,removable,altdevice=/dev/block/mmcblk1,display="MicroSD"
/devices/platform/mt_usb*         auto                   vfat    defaults                voldmanaged=usbotg:auto
